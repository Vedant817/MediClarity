# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — copy from .env.example (and cloudflare/voice-agent/.dev.vars.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE (create locally if you want workspace settings)
.vscode/
.idea/

# local scratch, screenshots, and uploaded fixtures
/temp
/attachments
/output/

# synthetic lab PDFs stay local; the fixture index is committed
/sample-reports/*
!/sample-reports/README.md

# local Python artifacts for the optional fine-tune track
__pycache__/
*.py[cod]
.venv/
venv/
ml/data/
ml/datasets/
ml/outputs/
ml/predictions.jsonl
