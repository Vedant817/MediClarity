# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Persistence
MONGO_URI=

# Document storage and OCR
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Open-weight text generation. Supported providers: groq, ollama.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Separate HMAC key used to pseudonymize IP addresses in audit records.
AUDIT_HASH_SECRET=

# Billing (server-only except NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_LAB_PRICE_ID=
# Recurring metered price configured at $0.05/unit and its attached meter event name.
STRIPE_LAB_USAGE_PRICE_ID=
STRIPE_LAB_METER_EVENT_NAME=lab_report_processed

# Development-only provider fixtures. Never enable this in production.
ALLOW_DEVELOPMENT_FIXTURES=false

# Cloudflare voice worker. Generate independent random secrets of at least 32 bytes.
CLOUDFLARE_VOICE_WORKER_URL=
VOICE_CAPABILITY_SECRET=
VOICE_SERVICE_SECRET=
