{
  "name": "@mediclarity/voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var NEXT_ORIGIN:http://localhost:3000 --var ALLOWED_ORIGIN:http://localhost:3000 --var TOKEN_AUDIENCE:mediclarity-voice-worker",
    "deploy": "wrangler deploy --var NEXT_ORIGIN:https://my-mediclarity.vercel.app --var ALLOWED_ORIGIN:https://my-mediclarity.vercel.app --var TOKEN_AUDIENCE:mediclarity-voice-worker",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:nova": "wrangler dev --config wrangler.nova-probe.jsonc --port 8788"
  },
  "dependencies": {
    "@cloudflare/voice": "0.4.0",
    "agents": "0.22.0",
    "ai": "7.0.90",
    "workers-ai-provider": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "4.128.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
